#!/bin/sh

# Get primary network interface
interface=$(ip route | grep default | awk '{print $5}' | head -n1)

if [ -z "$interface" ]; then
    echo "  No network"
    exit 0
fi

# Get received and transmitted bytes
rx1=$(cat /sys/class/net/$interface/statistics/rx_bytes)
tx1=$(cat /sys/class/net/$interface/statistics/tx_bytes)
sleep 1
rx2=$(cat /sys/class/net/$interface/statistics/rx_bytes)
tx2=$(cat /sys/class/net/$interface/statistics/tx_bytes)

# Calculate speeds
rx_speed=$(( (rx2 - rx1) / 1024 ))
tx_speed=$(( (tx2 - tx1) / 1024 ))

# Format output
if [ $rx_speed -gt 1024 ]; then
    rx_speed=$(echo "scale=1; $rx_speed / 1024" | bc)
    rx_unit="MB/s"
else
    rx_unit="KB/s"
fi

if [ $tx_speed -gt 1024 ]; then
    tx_speed=$(echo "scale=1; $tx_speed / 1024" | bc)
    tx_unit="MB/s"
else
    tx_unit="KB/s"
fi

echo " $rx_speed$rx_unit  $tx_speed$tx_unit"
