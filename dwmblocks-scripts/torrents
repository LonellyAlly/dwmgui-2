#!/bin/sh

# Check if qBittorrent is running
if pgrep -x "qbittorrent" >/dev/null; then
    # Try to get torrent count from qbittorrent-cli if installed
    if command -v qbittorrent-cli >/dev/null 2>&1; then
        # This requires qbittorrent-cli to be configured
        # You'd need to set up qbittorrent-cli first
        echo "  Active"
    else
        echo "  Running"
    fi
else
    echo "  Stopped"
fi

# Handle clicks
case $1 in
    1) qbittorrent & ;;
esac
